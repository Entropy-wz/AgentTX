{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttx.dev/schemas/recovery-contract.schema.json",
  "title": "AgentTx Recovery Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "tx_id",
    "effect_id",
    "required_action",
    "target",
    "blocking",
    "reversible",
    "verification",
    "status",
    "residual_warning",
    "updated_at"
  ],
  "properties": {
    "contract_id": { "type": "string" },
    "tx_id": { "type": "string" },
    "effect_id": { "type": "string" },
    "required_action": {
      "type": "string",
      "enum": ["restore_file", "delete_created_file", "manual_review", "residual_warning"]
    },
    "target": { "type": "string" },
    "blocking": { "type": "boolean" },
    "reversible": { "type": "boolean" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["hash_match", "file_absent", "manual_required", "unrecoverable_external"]
        },
        "expected_hash": { "type": ["string", "null"] }
      }
    },
    "status": {
      "type": "string",
      "enum": ["planned", "executed", "verified", "failed", "manual_required", "residual"]
    },
    "residual_warning": { "type": ["string", "null"] },
    "updated_at": { "type": "string" }
  }
}
