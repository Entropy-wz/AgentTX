{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttx.dev/schemas/verifier-report.schema.json",
  "title": "AgentTx Verifier Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tx_id",
    "status",
    "checks",
    "residual_effects",
    "residual_warnings",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["gate4.verifier_report.v0.3"]
    },
    "tx_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["recovered", "partially_recovered", "unrecoverable", "not_needed"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "effect_id", "target", "verification_type", "passed"],
        "properties": {
          "contract_id": { "type": "string" },
          "effect_id": { "type": "string" },
          "target": { "type": "string" },
          "verification_type": {
            "type": "string",
            "enum": ["hash_match", "file_absent", "manual_required", "unrecoverable_external"]
          },
          "passed": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "residual_effects": { "type": "number" },
    "residual_warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "updated_at": { "type": "string" }
  }
}
