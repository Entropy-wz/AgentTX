{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttx.dev/schemas/belief-report.schema.json",
  "title": "AgentTx Belief Repair Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tx_id",
    "tainted_claims",
    "verified_state",
    "repair_actions",
    "clean_summary",
    "metrics",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["gate5.belief_report.v0.3"]
    },
    "tx_id": { "type": "string" },
    "tainted_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source", "status", "evidence"],
        "properties": {
          "claim": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["failed_command", "effect_graph"]
          },
          "status": {
            "type": "string",
            "enum": ["invalidated"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "verified_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_exit", "recovery_status", "changed_files", "restored_files", "residual_warnings"],
      "properties": {
        "command_exit": {
          "type": "string",
          "enum": ["failed", "succeeded", "unknown"]
        },
        "recovery_status": {
          "type": "string",
          "enum": ["recovered", "partially_recovered", "unrecoverable", "not_needed", "unknown"]
        },
        "changed_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "restored_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "residual_warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "repair_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "invalidate_success_claim",
          "inject_verified_state",
          "require_replan_before_continuation",
          "taint_dependent_memory",
          "invalidate_tainted_descendants",
          "install_clean_summary"
        ]
      }
    },
    "clean_summary": { "type": "string" },
    "memory_repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "store_path",
        "tainted_memory_ids",
        "invalidated_memory_ids",
        "clean_memory_ids",
        "retrievable_tainted_memory_ids",
        "memory_clean",
        "events"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["agenttx.memory_repair.v0.3"]
        },
        "store_path": { "type": "string" },
        "tainted_memory_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "invalidated_memory_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "clean_memory_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "retrievable_tainted_memory_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memory_clean": { "type": "boolean" },
        "taint_propagation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "graph_path",
            "taint_roots",
            "propagated_memory_ids",
            "invalidated_descendant_ids",
            "clean_replacement_memory_ids",
            "propagation_depth",
            "graph_path_summary",
            "retrievable_tainted_memory_ids"
          ],
          "properties": {
            "schema_version": {
              "type": "string",
              "enum": ["agenttx.taint_propagation.v0.3"]
            },
            "graph_path": { "type": "string" },
            "taint_roots": {
              "type": "array",
              "items": { "type": "string" }
            },
            "propagated_memory_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "invalidated_descendant_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "clean_replacement_memory_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "propagation_depth": { "type": "number" },
            "graph_path_summary": {
              "type": "array",
              "items": { "type": "string" }
            },
            "retrievable_tainted_memory_ids": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "action", "result", "detail", "created_at"],
            "properties": {
              "event_id": { "type": "string" },
              "action": {
                "type": "string",
                "enum": ["record", "propagate_taint", "invalidate", "install_clean_summary", "verify"]
              },
              "memory_id": { "type": "string" },
              "target_memory_id": { "type": "string" },
              "result": {
                "type": "string",
                "enum": ["ok", "failed"]
              },
              "detail": { "type": "string" },
              "created_at": { "type": "string" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tcr_claim_detected",
        "tcr_claim_invalidated",
        "asr_clean_summary_generated",
        "asr_requires_replan"
      ],
      "properties": {
        "tcr_claim_detected": { "type": "boolean" },
        "tcr_claim_invalidated": { "type": "boolean" },
        "asr_clean_summary_generated": { "type": "boolean" },
        "asr_requires_replan": { "type": "boolean" },
        "memory_clean": { "type": "boolean" },
        "tainted_memory_retrievable": { "type": "boolean" }
      }
    },
    "note": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
