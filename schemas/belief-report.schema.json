{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttx.dev/schemas/belief-report.schema.json",
  "title": "AgentTx Belief Repair Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tx_id",
    "tainted_claims",
    "verified_state",
    "repair_actions",
    "clean_summary",
    "metrics",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["gate5.belief_report.v0.3"]
    },
    "tx_id": { "type": "string" },
    "tainted_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source", "status", "evidence"],
        "properties": {
          "claim": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["failed_command", "effect_graph"]
          },
          "status": {
            "type": "string",
            "enum": ["invalidated"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "verified_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_exit", "recovery_status", "changed_files", "restored_files", "residual_warnings"],
      "properties": {
        "command_exit": {
          "type": "string",
          "enum": ["failed", "succeeded", "unknown"]
        },
        "recovery_status": {
          "type": "string",
          "enum": ["recovered", "partially_recovered", "unrecoverable", "not_needed", "unknown"]
        },
        "changed_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "restored_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "residual_warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "repair_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["invalidate_success_claim", "inject_verified_state", "require_replan_before_continuation"]
      }
    },
    "clean_summary": { "type": "string" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tcr_claim_detected",
        "tcr_claim_invalidated",
        "asr_clean_summary_generated",
        "asr_requires_replan"
      ],
      "properties": {
        "tcr_claim_detected": { "type": "boolean" },
        "tcr_claim_invalidated": { "type": "boolean" },
        "asr_clean_summary_generated": { "type": "boolean" },
        "asr_requires_replan": { "type": "boolean" }
      }
    },
    "note": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
