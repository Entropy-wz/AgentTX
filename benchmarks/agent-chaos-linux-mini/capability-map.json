      "name": "Claude Code plugin is loadable",
      "validated_by": ["E0_plugin_validate"],
      "required_artifacts": ["plugin_validate.log"],
      "expected_signals": ["Validation passed"]
    },
    {
      "id": "critical_risk_block",
