      "required_artifacts": ["risk.json", "effects.jsonl"],
      "expected_signals": ["CRITICAL", "command.blocked"]
    },
    {
      "id": "safe_command_quiet",
      "name": "SAFE command quiet path",
      "validated_by": ["E2_safe_quiet_check"],
      "required_artifacts": ["request.json", "risk.json"],
      "expected_signals": ["SAFE", "no_memory_capsule", "no_alignment_warning"]
    },
    {
      "id": "filesystem_recovery",
